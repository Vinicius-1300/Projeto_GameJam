[gd_scene format=3 uid="uid://cmiss4tvu1wc1"]

[sub_resource type="GDScript" id="GDScript_x5fmj"]
script/source = "extends Node3D

func _ready() -> void:
	# Ativa as partículas (faíscas)
	if has_node(\"GPUParticles3D\"):
		$GPUParticles3D.emitting = true
	
	# Efeito de Fade Out no Decal para ele não sumir do nada
	if has_node(\"Decal\"):
		var tween = create_tween()
		# O buraco de bala fica visível por 1.5s e depois leva 0.5s para sumir
		tween.tween_interval(1.5)
		tween.tween_property($Decal, \"albedo_mix\", 0.0, 0.5)
	
	# Espera o tempo total e deleta a cena
	await get_tree().create_timer(2.0).timeout
	queue_free()
"

