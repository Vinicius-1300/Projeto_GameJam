[sub_resource type="GDScript" id="GDScript_k05ng"]
script/source = "extends StaticBody3D

var vida: float = 150.0
var destruido: bool = false
var hud_node = null

func _ready() -> void:
	add_to_group(\"destacaveis\")
	hud_node = get_tree().current_scene.find_child(\"HUD\", true, false)

func receber_dano(qtd: float, _tipo_dano: String = \"normal\") -> void:
	if destruido: return
	
	vida -= qtd
	
	if hud_node and hud_node.has_method(\"mostrar_vida_inimigo\"):
		hud_node.mostrar_vida_inimigo(\"NÚCLEO DE ENERGIA\", max(vida, 0), 150.0)
	
	var mesh = $MeshInstance3D
	if mesh and mesh.material_override:
		var cor_original = mesh.material_override.albedo_color
		mesh.material_override.albedo_color = Color.WHITE
		var tween = create_tween()
		tween.tween_property(mesh.material_override, \"albedo_color\", cor_original, 0.2)
	
	if vida <= 0:
		destruir()

func destruir() -> void:
	destruido = true
	
	# --- SOM DA EXPLOSÃO AQUI ---
	if SfxManager.has_method(\"play_explosao\"):
		SfxManager.play_explosao()
	
	var luz_explosao = OmniLight3D.new()
	luz_explosao.light_color = Color(0.2, 0.5, 1.0)
	luz_explosao.light_energy = 8.0
	luz_explosao.omni_range = 15.0
	get_tree().current_scene.add_child(luz_explosao)
	luz_explosao.global_position = global_position + Vector3(0, 1.0, 0)
	
	var tween_luz = luz_explosao.create_tween()
	tween_luz.tween_property(luz_explosao, \"light_energy\", 0.0, 0.4)
	tween_luz.tween_callback(luz_explosao.queue_free)
	
	get_tree().call_group(\"porta_extracao\", \"abrir_porta\")
	
	queue_free()
"

