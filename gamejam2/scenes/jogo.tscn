[sub_resource type="GDScript" id="GDScript_4sjka"]
script/source = "extends StaticBody3D

# --- CONFIGURAÇÕES DE VIDA ---
var nome_inimigo: String = \"TORRE DE SEGURANÇA\"
var vida_maxima: float = 80.0
var vida: float = 80.0
var destruida: bool = false
var em_blackout: bool = false

# --- CONFIGURAÇÕES DE IA ---
var angulo_varredura: float = 45.0 
var velocidade_varredura: float = 1.5
var tempo_interno: float = 0.0

var dano_tiro: float = 10.0
var tempo_entre_tiros: float = 0.2
var timer_tiro: float = 0.0
var atirando: bool = false

# --- REFERÊNCIAS ---
@onready var cabeca = $Cabeca
@onready var raycast = $Cabeca/RayCast3D
@onready var laser_visual = $Cabeca/LaserVisual
var hud_node = null

func _ready() -> void:
	add_to_group(\"inimigos\")
	add_to_group(\"destacaveis\")
	
	# Busca o HUD na cena
	hud_node = get_tree().current_scene.find_child(\"HUD\", true, false)
	
	if laser_visual:
		var mat_laser = StandardMaterial3D.new()
		mat_laser.albedo_color = Color(1.0, 0.0, 0.0, 0.5)
		mat_laser.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		mat_laser.emission_enabled = true
		mat_laser.emission = Color(1.0, 0.0, 0.0)
		mat_laser.emission_energy_multiplier = 3.0
		laser_visual.material_override = mat_laser

func _physics_process(delta: float) -> void:
	if destruida or em_blackout:
		laser_visual.visible = false
		return
		
	laser_visual.visible = true
	
	var distancia_laser = 20.0
	if raycast.is_colliding():
		var ponto_colisao = raycast.get_collision_point()
		distancia_laser = cabeca.global_position.distance_to(ponto_colisao)
		
		var alvo = raycast.get_collider()
		if alvo and (alvo.name == \"Player\" or alvo.name == \"player\"):
			atirando = true
			mirar_no_jogador(alvo.global_position, delta)
			atirar(alvo, delta)
		else:
			atirando = false
	else:
		atirando = false
		
	if laser_visual.mesh is CylinderMesh:
		laser_visual.mesh.height = distancia_laser
		laser_visual.position.z = -distancia_laser / 2.0
		
	if not atirando:
		tempo_interno += delta * velocidade_varredura
		cabeca.rotation_degrees.y = sin(tempo_interno) * angulo_varredura

func mirar_no_jogador(pos_alvo: Vector3, delta: float) -> void:
	var direcao = pos_alvo - cabeca.global_position
	direcao.y = 0 
	if direcao.length() > 0.1:
		var transform_alvo = cabeca.global_transform.looking_at(cabeca.global_position + direcao, Vector3.UP)
		cabeca.global_transform = cabeca.global_transform.interpolate_with(transform_alvo, delta * 8.0)

func atirar(alvo: Node3D, delta: float) -> void:
	timer_tiro -= delta
	if timer_tiro <= 0.0:
		timer_tiro = tempo_entre_tiros
		
		if laser_visual and laser_visual.material_override:
			laser_visual.material_override.emission_energy_multiplier = 10.0
			var tween = create_tween()
			tween.tween_property(laser_visual.material_override, \"emission_energy_multiplier\", 3.0, 0.1)
			
		if alvo.has_method(\"tomar_dano\"):
			alvo.tomar_dano(dano_tiro)

func sofrer_blackout(tempo: float) -> void:
	if destruida: return
	em_blackout = true
	await get_tree().create_timer(tempo).timeout
	em_blackout = false

# --- SISTEMA DE DANO E HUD ---
func receber_dano(qtd: float, _tipo_dano: String = \"normal\") -> void:
	if destruida: return
	vida -= qtd
	
	# Atualiza a barra de vida no topo da tela (HUD)
	if hud_node and hud_node.has_method(\"mostrar_vida_inimigo\"):
		hud_node.mostrar_vida_inimigo(nome_inimigo, max(vida, 0), vida_maxima)
	
	# Efeito visual de piscar ao levar dano
	var mesh_arma = cabeca.get_node_or_null(\"MeshArma\")
	if mesh_arma and mesh_arma.material_override:
		var cor_original = mesh_arma.material_override.albedo_color
		mesh_arma.material_override.albedo_color = Color.WHITE
		var tween = create_tween()
		tween.tween_property(mesh_arma.material_override, \"albedo_color\", cor_original, 0.1)
			
	if vida <= 0:
		destruir()

func destruir() -> void:
	destruida = true
	
	# Chama o som de explosão do SfxManager
	if SfxManager.has_method(\"play_explosao\"):
		SfxManager.play_explosao()
		
	# Zera a barra no HUD antes de sumir
	if hud_node and hud_node.has_method(\"mostrar_vida_inimigo\"):
		hud_node.mostrar_vida_inimigo(nome_inimigo, 0.0, vida_maxima)
	
	if laser_visual:
		laser_visual.queue_free()
		
	# Efeito visual da explosão (Luz Laranja)
	var luz_explosao = OmniLight3D.new()
	luz_explosao.light_color = Color(1.0, 0.4, 0.0)
	luz_explosao.light_energy = 8.0
	luz_explosao.omni_range = 12.0
	get_tree().current_scene.add_child(luz_explosao)
	luz_explosao.global_position = global_position + Vector3(0, 1.0, 0)
	
	var tween_luz = luz_explosao.create_tween()
	tween_luz.tween_property(luz_explosao, \"light_energy\", 0.0, 0.4)
	tween_luz.tween_callback(luz_explosao.queue_free)
	
	queue_free()
"

