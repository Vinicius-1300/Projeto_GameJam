[sub_resource type="GDScript" id="GDScript_1b3iq"]
script/source = "extends Light3D

var energia_original: float

func _ready() -> void:
	# Entra no grupo para o Luís conseguir achar e apagar
	add_to_group(\"luzes\")
	energia_original = light_energy

func desligar_temporariamente(tempo: float) -> void:
	var tween = create_tween()
	# Apaga a luz rapidamente
	tween.tween_property(self, \"light_energy\", 0.0, 0.2)
	
	await get_tree().create_timer(tempo).timeout
	
	# Acende a luz novamente
	var tween_volta = create_tween()
	tween_volta.tween_property(self, \"light_energy\", energia_original, 0.5)
"

