[sub_resource type="GDScript" id="GDScript_0c0ry"]
script/source = "extends Area3D

var trancada: bool = true

@onready var malha_porta = $MeshPorta
@onready var luz_indicadora = $OmniLight3D

func _ready() -> void:
	add_to_group(\"porta_extracao\")
	body_entered.connect(_on_body_entered)
	
	if luz_indicadora:
		luz_indicadora.light_color = Color.RED

func abrir_porta() -> void:
	if not trancada: return
	trancada = false
	
	if luz_indicadora:
		luz_indicadora.light_color = Color.GREEN
		
	if malha_porta:
		var tween = create_tween()
		tween.tween_property(malha_porta, \"position:y\", 4.0, 1.5).set_trans(Tween.TRANS_SINE)

func _on_body_entered(body: Node3D) -> void:
	if (body.name == \"Player\" or body.name == \"player\") and not trancada:
		vencer_fase()

func vencer_fase() -> void:
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	
	var hud_node = get_tree().current_scene.find_child(\"HUD\", true, false)
	if hud_node:
		hud_node.hide()
	
	var tela_vitoria = ColorRect.new()
	tela_vitoria.color = Color(0, 0, 0, 0) 
	tela_vitoria.set_anchors_preset(Control.PRESET_FULL_RECT)
	tela_vitoria.process_mode = Node.PROCESS_MODE_ALWAYS 
	
	# --- A MÁGICA DO ALINHAMENTO ---
	# O CenterContainer força tudo que está dentro dele a ficar no centro exato da tela
	var center_container = CenterContainer.new()
	center_container.set_anchors_preset(Control.PRESET_FULL_RECT)
	tela_vitoria.add_child(center_container)
	
	var vbox = VBoxContainer.new()
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override(\"separation\", 20)
	center_container.add_child(vbox)
	# -------------------------------
	
	var texto = Label.new()
	texto.text = \"MISSÃO CUMPRIDA\"
	texto.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	texto.add_theme_font_size_override(\"font_size\", 50)
	vbox.add_child(texto)
	
	var btn_continuar = Button.new()
	btn_continuar.text = \"Continuar para a próxima fase\"
	btn_continuar.add_theme_font_size_override(\"font_size\", 24)
	btn_continuar.pressed.connect(_on_btn_continuar_pressed)
	vbox.add_child(btn_continuar)
	
	var btn_reiniciar = Button.new()
	btn_reiniciar.text = \"Reiniciar Fase\"
	btn_reiniciar.add_theme_font_size_override(\"font_size\", 24)
	btn_reiniciar.pressed.connect(_on_btn_reiniciar_pressed)
	vbox.add_child(btn_reiniciar)
	
	get_tree().current_scene.add_child(tela_vitoria)
	
	var tween = create_tween()
	tween.tween_property(tela_vitoria, \"color:a\", 1.0, 1.0)
	tween.tween_callback(func(): get_tree().paused = true)


# --- FUNÇÕES DOS BOTÕES ---

func _on_btn_continuar_pressed() -> void:
	print(\"Carregando próxima fase...\")
	# get_tree().paused = false
	# get_tree().change_scene_to_file(\"res://scenes/fase_2.tscn\")

func _on_btn_reiniciar_pressed() -> void:
	get_tree().paused = false
	get_tree().reload_current_scene()\\
"

